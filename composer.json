{
    "name": "illusorium/kohana-email",
    "description": "Email helper for Kohana, uses Swiftmailer. Based on shadowhand/email repo that is now removed.",
    "type": "kohana-module",
    "keywords": ["kohana", "email", "helper", "module", "library", "swiftmailer"],
    "homepage": "http://github.com/illusorium/email",
    "license": "MIT",
    "require": {
        "php": ">=7.0.0",
        "kohana/core": "3.5.*",
        "swiftmailer/swiftmailer": "^6.3"
    },
    "extra": {
        "branch-alias": {
            "dev-3.5/master": "3.5.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
